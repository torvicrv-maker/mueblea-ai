# Create a Gemini Developer API key in Google AI Studio; keep it private in Vercel.
GEMINI_API_KEY=
MUEBLEA_VISION_ENABLED=false
MUEBLEA_VISION_MODEL=gemini-3.8-flash
MUEBLEA_ALLOWED_ORIGINS=https://torvicrv-maker.github.io

# Origin of the Vercel deployment that serves /api/design-from-photo.
# Set as a GitHub Actions repository variable for the GitHub Pages build.
NEXT_PUBLIC_MUEBLEA_API_ORIGIN=
